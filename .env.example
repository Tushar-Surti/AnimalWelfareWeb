# ─────────────────────────────────────────────────────────────────────────────
# Root .env — used only by `npm run db:push` (the migration runner).
# Supabase dashboard → Project Settings → Database → Connection string → URI
# Pick the "Session pooler" string (port 5432) and paste your DB password in.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-DB-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
